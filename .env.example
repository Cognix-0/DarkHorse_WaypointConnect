# Copy to .env and change every value marked CHANGE_ME.
# Public domain for Caddy. Use "localhost" on your own machine.
DOMAIN=localhost

# PostgreSQL
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:15432/waypoint

# API
JWT_SECRET=CHANGE_ME_to_a_long_random_string
API_PORT=3000

# Password for the four seeded demo accounts
DEMO_PASSWORD=waypoint-demo

# Demo delivery day loaded by the seed (payday, chilled demand exceeds reefer capacity)
DEMO_DATE=2026-03-25
