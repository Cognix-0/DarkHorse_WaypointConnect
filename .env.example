# Copy to .env and change every value marked CHANGE_ME.
# Public domain for Caddy. Use "localhost" on your own machine.
DOMAIN=localhost

# PostgreSQL
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:15432/waypoint

# API
JWT_SECRET=CHANGE_ME_to_a_long_random_string
API_PORT=3000

# Every account (one per vehicle, store, depot dispatcher and loader) gets its own password derived from this.
# List them with: pnpm credentials   (never commit the output)
ACCOUNT_SECRET=CHANGE_ME_to_another_long_random_string

# Leave empty: every screen shows today and the real Colombo time. Set YYYY-MM-DD to rehearse one fixed day.
DEMO_DATE=
