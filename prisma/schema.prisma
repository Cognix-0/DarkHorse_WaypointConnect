// Waypoint Connect data model.
// Reference data (outlets, vehicles) comes from the competition CSVs via prisma/seed.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  dispatcher
  loader
  driver
  store
}

enum Brand {
  Fresh
  Style
  Tech
}

enum Temp {
  ambient
  chilled
}

enum DockType {
  rear_dock
  street
  mall_bay
}

enum Parking {
  normal
  van_only
  mall_dock
}

enum Depot {
  Peliyagoda
  Kandy
}

enum VehicleType {
  truck
  van
}

enum VehicleTemp {
  reefer
  ambient
}

enum OrderStatus {
  placed
  locked
  planned
  deferred
  loaded
  out_for_delivery
  delivered
  failed
  received
  cancelled
}

enum PlanStatus {
  draft
  published
}

enum DeferralReason {
  no_reefer_capacity
  vehicle_full
  time_window
  fuel_quota
  no_vehicle
  other
}

enum DeferralType {
  unavoidable
  choice
}

enum StopStatus {
  pending
  arrived
  delivered
  failed
}

enum LoadStatus {
  to_load
  loading
  sealed
}

model Outlet {
  id           String    @id // OUT001
  brand        Brand
  district     String
  depot        Depot
  dockType     DockType
  parking      Parking
  mallWindow   String?
  windowOpen   String // HH:MM
  windowClose  String
  lastServedOn DateTime? @db.Date
  managerName  String?
  managerPhone String?
  /// delivery note for drivers, e.g. "Hill road, park on the left"
  deliveryNote String?
  orders       Order[]
  users        User[]
}

model Vehicle {
  id               String             @id // VEH001
  type             VehicleType
  temp             VehicleTemp
  weightCapKg      Float
  volumeCapM3      Float
  depot            Depot
  kmPerL           Float
  weeklyFuelQuotaL Float
  fuelUsedWeekL    Float              @default(0)
  driverName       String?
  dayStatus        VehicleDayStatus[]
  trips            Trip[]
  users            User[]
}

/// Workshop days. No row = available.
model VehicleDayStatus {
  vehicleId String
  date      DateTime @db.Date
  status    String // in_workshop
  note      String?
  setById   String?
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@id([vehicleId, date])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  depot        Depot?
  outletId     String?
  vehicleId    String?
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt    DateTime @default(now())
}

model Order {
  id           String      @id @default(cuid())
  outletId     String
  deliveryDate DateTime    @db.Date
  temp         Temp
  units        Int
  weightKg     Float
  volumeM3     Float
  status       OrderStatus @default(placed)
  note         String?
  placedAt     DateTime    @default(now())
  /// reference from the competition data (e.g. S1-003) when seeded
  sourceRef    String?
  outlet       Outlet      @relation(fields: [outletId], references: [id])
  stop         TripStop?
  deferrals    Deferral[]
  loadChecks   LoadCheck[]
  receipt      Receipt?
  lines        OrderLine[]

  @@index([deliveryDate, status])
}

/// Goods line ("item") of an order, counted in packs. Packs on all lines add up to Order.units.
model OrderLine {
  id         String    @id @default(cuid())
  orderId    String
  seq        Int
  product    String
  pack       String
  packSize   String
  packs      Int
  ordered    String
  weightKg   Float
  loadedAt   DateTime?
  shortPacks Int       @default(0)
  problem    String?
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Plan {
  id          String     @id @default(cuid())
  date        DateTime   @db.Date
  depot       Depot
  status      PlanStatus @default(draft)
  /// 0 until first published; +1 on every re-publish (drivers refetch when it changes)
  version     Int        @default(0)
  publishedAt DateTime?
  /// recovery options taken on the Deferral Review screen, e.g. {"B":"requested"}
  options     Json       @default("{}")
  trips       Trip[]
  deferrals   Deferral[]

  @@unique([date, depot])
}

model Trip {
  id         String     @id @default(cuid())
  planId     String
  vehicleId  String
  tripNo     Int // 1 or 2
  brand      Brand
  district   String
  departAt   String // HH:MM
  minutes    Int
  loadStatus LoadStatus @default(to_load)
  /// dock bay, assigned when the plan is published (0 = not yet)
  bay        Int        @default(0)
  loaderId   String?
  loaderName String?
  loadingStartedAt DateTime?
  sealedAt   DateTime?
  sealNo     String?
  reeferTempC Float?
  heldAt     DateTime?
  departedAt DateTime?
  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id])
  stops      TripStop[]
  loadChecks LoadCheck[]

  @@unique([planId, vehicleId, tripNo])
}

model TripStop {
  id             String          @id @default(cuid())
  tripId         String
  orderId        String          @unique
  seq            Int
  plannedArrival String // HH:MM
  status         StopStatus      @default(pending)
  arrivedAt      DateTime?
  deliveredAt    DateTime?
  deliveredUnits Int?
  receiverName   String?
  failedReason   String?
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id])
  events         DeliveryEvent[]
}

model Deferral {
  id        String         @id @default(cuid())
  orderId   String
  planId    String?
  reason    DeferralReason
  type      DeferralType
  note      String?
  detail    String?
  newDate   DateTime       @db.Date
  byUserId  String?
  /// second deferrals (outlet also skipped on the last run) need an explicit confirmation before publishing
  confirmedAt DateTime?
  /// the store manager's answer on SM6: accepted | cancelled
  storeResponse String?
  respondedAt   DateTime?
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id])
  plan      Plan?          @relation(fields: [planId], references: [id])

  @@index([orderId])
}

/// A loader's problem report on one goods line (L3).
model LoadCheck {
  id          String   @id @default(cuid())
  tripId      String
  orderId     String
  lineId      String?
  loadedUnits Int      @default(0)
  /// packs affected
  shortUnits  Int      @default(0)
  problem     String? // damaged | short | wrong_pack | no_space | wrong_temp | vehicle | other
  action      String? // carry_over | replace | hold
  note        String?
  photo       String?
  byUserId    String?
  byName      String?
  at          DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id])
}

/// Offline-first: one row per client event; eventId makes sync idempotent.
model DeliveryEvent {
  eventId        String   @id
  stopId         String
  type           String // stop.arrived | stop.delivered | stop.failed
  occurredAt     DateTime
  receivedAt     DateTime @default(now())
  deviceId       String
  receiverName   String?
  deliveredUnits Int?
  reason         String?
  note           String?
  photo          String? // data URL (small JPEG)
  signature      String? // data URL (PNG)
  outcome        String?
  stop           TripStop @relation(fields: [stopId], references: [id])
}

/// What each published version of a plan looked like, so the dock can see "v1 → v2".
model PlanVersion {
  id          String   @id @default(cuid())
  planId      String
  version     Int
  /// [{ vehicleId, tripNo, orderIds }]
  snapshot    Json
  publishedAt DateTime @default(now())
  byName      String?

  @@unique([planId, version])
}

/// Who confirmed they are working from which plan version (loaders, drivers).
model PlanAck {
  id       String   @id @default(cuid())
  planId   String
  version  Int
  userId   String
  userName String
  role     Role
  at       DateTime @default(now())

  @@unique([planId, version, userId])
}

/// A loader moved an order's goods to its new vehicle after a plan change (L4 "Mark moved").
model LoadMove {
  id       String   @id @default(cuid())
  planId   String
  version  Int
  orderId  String
  byName   String?
  movedAt  DateTime @default(now())

  @@unique([planId, version, orderId])
}

/// The store manager's confirmation of what arrived (SM5).
model Receipt {
  id          String    @id @default(cuid())
  orderId     String    @unique
  confirmed   Boolean
  issue       String?
  issueUnits  Int?
  note        String?
  /// [{ lineId, product, ordered, received, status: ok | short | damaged }]
  lines       Json      @default("[]")
  deliveredAt DateTime?
  byName      String?
  at          DateTime  @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  role      Role?
  outletId  String?
  userId    String?
  kind      String
  title     String?
  message   String
  refs      Json     @default("{}")
  read      Boolean  @default(false)
  /// the dispatcher acted on this alert
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([outletId, read])
  @@index([role, createdAt])
}
