{
  "name": "waypoint-connect",
  "private": true,
  "version": "0.1.0",
  "description": "Waypoint Connect - Tech-Triathlon 2026, Team Dark Horse",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @waypoint/api dev",
    "dev:web": "pnpm --filter @waypoint/web dev",
    "test": "pnpm --filter @waypoint/shared test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "check:2b": "tsx scripts/run-task2b.ts && python3 check_allocation.py out/submission_task2b.csv"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0",
    "@types/bcryptjs": "^2.4.6"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  }
}
